<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | BookNest</title>
  <meta name="description" content="BookNest — your online bookstore for bestsellers, new arrivals, and rare finds.">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="#main" class="visually-hidden">Skip to main content</a>

  <header class="navbar">
    <div class="container">
      <a href="/" class="navbar-brand">📚 BookNest</a>
      <button id="navToggle" class="navbar-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="navMenu">
        <span></span>
      </button>
      <nav id="navMenu" class="navbar-menu" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/catalogue">Catalogue</a>
        <% if (user) { %>
          <a href="/cart">Cart <span id="cartBadge" class="navbar-cart-badge" style="display:none">0</span></a>
          <a href="/profile">My Profile</a>
          <% if (user.role === 'admin') { %>
            <a href="/admin">Admin Dashboard</a>
          <% } %>
          <button id="logoutBtn">Logout (<%= user.name.split(' ')[0] %>)</button>
        <% } else { %>
          <a href="/login">Login</a>
          <a href="/register">Register</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main id="main">
