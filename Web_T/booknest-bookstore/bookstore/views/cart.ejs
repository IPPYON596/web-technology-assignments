<%- include('partials/header') %>
<div class="container section">
  <h1>Your Cart</h1>
  <div id="cartContent"><div class="skeleton" style="height:200px;"></div></div>
</div>

<script>
  const cartContent = document.getElementById('cartContent');

  function itemRow(item) {
    const book = item.book;
    if (!book) return '';
    return `
      <div class="cart-item" data-item-id="${item._id}">
        <img src="${book.coverImage}" alt="Cover of ${escapeHtml(book.title)}">
        <div class="cart-item-info">
          <a href="/books/${book._id}" style="font-weight:600;">${escapeHtml(book.title)}</a>
          <div class="text-muted" style="font-size:.85rem;">${escapeHtml(book.author)} · ${money(book.price)} each</div>
          <div class="qty-control mt-1">
            <button class="qty-decrease" aria-label="Decrease quantity">−</button>
            <span>${item.quantity}</span>
            <button class="qty-increase" aria-label="Increase quantity">+</button>
            <button class="btn btn-outline btn-sm remove-item" style="margin-left:12px;">Remove</button>
          </div>
        </div>
        <div style="font-weight:700;">${money(book.price * item.quantity)}</div>
      </div>`;
  }

  async function loadCart() {
    try {
      const res = await api.get('/api/cart');
      const items = res.data.items.filter(i => i.book);
      if (items.length === 0) {
        cartContent.innerHTML = `<div class="empty-state"><p>Your cart is empty.</p><a href="/catalogue" class="btn btn-primary">Browse Books</a></div>`;
        return;
      }
      cartContent.innerHTML = `
        <div>${items.map(itemRow).join('')}</div>
        <div class="cart-summary">
          <div class="summary-row"><span>Subtotal</span><span>${money(res.total)}</span></div>
          <div class="summary-row"><span>Shipping</span><span>Calculated at checkout</span></div>
          <div class="summary-row total"><span>Total</span><span>${money(res.total)}</span></div>
          <a href="/checkout" class="btn btn-primary btn-block mt-2">Proceed to Checkout</a>
        </div>`;
      attachHandlers();
    } catch (err) {
      cartContent.innerHTML = `<div class="empty-state"><p>${escapeHtml(err.message)}</p></div>`;
    }
  }

  function attachHandlers() {
    document.querySelectorAll('.cart-item').forEach(row => {
      const itemId = row.dataset.itemId;
      const qtySpan = row.querySelector('.qty-control span');

      row.querySelector('.qty-increase').addEventListener('click', async () => {
        const newQty = Number(qtySpan.textContent) + 1;
        try { await api.put(`/api/cart/${itemId}`, { quantity: newQty }); loadCart(); refreshCartBadge(); }
        catch (err) { toast(err.message, 'error'); }
      });

      row.querySelector('.qty-decrease').addEventListener('click', async () => {
        const newQty = Number(qtySpan.textContent) - 1;
        if (newQty < 1) return;
        try { await api.put(`/api/cart/${itemId}`, { quantity: newQty }); loadCart(); refreshCartBadge(); }
        catch (err) { toast(err.message, 'error'); }
      });

      row.querySelector('.remove-item').addEventListener('click', async () => {
        try { await api.delete(`/api/cart/${itemId}`); loadCart(); refreshCartBadge(); toast('Item removed'); }
        catch (err) { toast(err.message, 'error'); }
      });
    });
  }

  loadCart();
</script>
<%- include('partials/footer') %>
