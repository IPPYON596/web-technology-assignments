<%- include('partials/header') %>
<div class="container section" id="detailContainer">
  <div class="skeleton" style="height:400px;"></div>
</div>

<script>
  const bookId = <%- JSON.stringify(bookId) %>;
  const isLoggedIn = <%- JSON.stringify(!!user) %>;
  const container = document.getElementById('detailContainer');

  function renderReview(r) {
    return `<div class="cart-item" style="align-items:flex-start;">
      <div class="cart-item-info">
        <strong>${escapeHtml(r.user?.name || 'Anonymous')}</strong> — ${stars(r.rating)}
        <p class="text-muted" style="margin:4px 0 0;">${escapeHtml(r.comment || '')}</p>
      </div>
    </div>`;
  }

  async function load() {
    try {
      const res = await api.get(`/api/books/${bookId}`);
      const book = res.data;
      container.innerHTML = `
        <div style="display:grid; grid-template-columns: 1fr; gap:24px;" class="book-detail-grid">
          <div style="max-width:280px;">
            <img src="${book.coverImage}" alt="Cover of ${escapeHtml(book.title)}" style="border-radius:10px; box-shadow:var(--shadow-lg);">
          </div>
          <div>
            <h1>${escapeHtml(book.title)}</h1>
            <p class="text-muted">by ${escapeHtml(book.author)} · ${escapeHtml(book.category?.name || '')}</p>
            <div class="mb-1">${stars(book.rating)} <span class="text-muted">(${book.ratingsCount} reviews)</span></div>
            <div style="font-size:1.6rem; font-weight:700;">${money(book.price)}</div>
            <span class="stock-badge ${book.stock > 0 ? 'in' : 'out'} mt-1">${book.stock > 0 ? book.stock + ' in stock' : 'Out of stock'}</span>
            <div class="d-flex gap-1 mt-2">
              <input type="number" id="qtyInput" class="form-control" value="1" min="1" max="${book.stock}" style="max-width:90px;">
              <button class="btn btn-primary add-to-cart-btn" data-book-id="${book._id}" id="addBtn" ${book.stock <= 0 ? 'disabled' : ''}>Add to Cart</button>
            </div>
            <h3 class="mt-3">Description</h3>
            <p>${escapeHtml(book.description || 'No description available.')}</p>
            <dl class="text-muted" style="font-size:.85rem;">
              <div>ISBN: ${escapeHtml(book.isbn)}</div>
              <div>Publisher: ${escapeHtml(book.publisher || '—')} ${book.publishedYear ? '(' + book.publishedYear + ')' : ''}</div>
              <div>Pages: ${book.pages || '—'} · Language: ${escapeHtml(book.language || '—')}</div>
            </dl>
          </div>
        </div>

        <section class="mt-3">
          <h2>Reviews</h2>
          <div id="reviewList">${res.reviews.length ? res.reviews.map(renderReview).join('') : '<p class="text-muted">No reviews yet. Be the first to review this book!</p>'}</div>
          ${isLoggedIn ? `
          <form id="reviewForm" class="mt-2" style="max-width:480px;">
            <div class="form-group">
              <label for="reviewRating">Your Rating</label>
              <select class="form-control" id="reviewRating" required>
                <option value="5">5 - Excellent</option>
                <option value="4">4 - Good</option>
                <option value="3">3 - Average</option>
                <option value="2">2 - Poor</option>
                <option value="1">1 - Terrible</option>
              </select>
            </div>
            <div class="form-group">
              <label for="reviewComment">Comment</label>
              <textarea class="form-control" id="reviewComment" rows="3" maxlength="1000"></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Submit Review</button>
          </form>` : `<p class="text-muted"><a href="/login">Login</a> to leave a review.</p>`}
        </section>

        <section class="mt-3">
          <h2>Related Books</h2>
          <div class="book-grid" id="relatedGrid"></div>
        </section>
      `;

      const relatedGrid = document.getElementById('relatedGrid');
      relatedGrid.innerHTML = res.relatedBooks.map(b => `
        <article class="book-card">
          <a href="/books/${b._id}" class="book-card-cover"><img src="${b.coverImage}" alt="Cover of ${escapeHtml(b.title)}" loading="lazy"></a>
          <div class="book-card-body">
            <a href="/books/${b._id}" class="book-card-title">${escapeHtml(b.title)}</a>
            <div class="book-card-author">${escapeHtml(b.author)}</div>
            <div class="book-card-price">${money(b.price)}</div>
          </div>
        </article>`).join('') || '<p class="text-muted">No related books found.</p>';

      const addBtn = document.getElementById('addBtn');
      const qtyInput = document.getElementById('qtyInput');
      if (qtyInput && addBtn) {
        addBtn.dataset.quantity = qtyInput.value || 1;
        qtyInput.addEventListener('change', () => { addBtn.dataset.quantity = qtyInput.value || 1; });
        qtyInput.addEventListener('input', () => { addBtn.dataset.quantity = qtyInput.value || 1; });
        addBtn.addEventListener('click', () => { addBtn.dataset.quantity = qtyInput.value || 1; });
      }

      const reviewForm = document.getElementById('reviewForm');
      if (reviewForm) {
        reviewForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            await api.post('/api/reviews', {
              bookId,
              rating: Number(document.getElementById('reviewRating').value),
              comment: document.getElementById('reviewComment').value,
            });
            toast('Review submitted');
            load();
          } catch (err) {
            toast(err.message, 'error');
          }
        });
      }
    } catch (err) {
      container.innerHTML = `<div class="empty-state"><p>${escapeHtml(err.message)}</p><a href="/catalogue" class="btn btn-primary">Back to Catalogue</a></div>`;
    }
  }
  load();
</script>
<style>
  @media (min-width: 700px) { .book-detail-grid { grid-template-columns: 280px 1fr !important; } }
</style>
<%- include('partials/footer') %>
